IMAP_USER=your-email@example.com
IMAP_PASSWORD=your-email-password
IMAP_HOST=imap.example.com
IMAP_PORT=993

PAPRA_BASE_URL=https://api.papra.app
PAPRA_API_TOKEN=your-papra-api-token
PAPRA_DEFAULT_ORG_ID=your-default-org-id

EMAIL_TO_ORG_MAP={"recipient@yourdomain.com":"org_id_here"}

TRASH_AFTER_IMPORT=false
TRASH_FOLDER=Trash
